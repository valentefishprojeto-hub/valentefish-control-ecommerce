# Copie para .env.instagram.local na raiz. Nunca preencha este arquivo versionado.
# Sem valores reais; mantenha as duas automações desativadas durante o setup.
DATABASE_URL=
APP_URL=
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
# ID numérico da conta de teste tironitech, não o @username.
IG_BUSINESS_ID=
# Escolha uma versão suportada pelo app Meta.
# ANTHROPIC_* é opcional: sem eles, o bot responde preço e link direto do catálogo (sem IA).
META_GRAPH_VERSION=
# graph.facebook.com para apps novos (Unified Login, token de usuário do sistema); vazio = graph.instagram.com.
IG_API_HOST=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
IG_BOT_ENABLED=false
IG_DRY_RUN=false
IG_HUMAN_PAUSE_HOURS=12
# Opcional: na ausência, o bot orienta calcular frete no checkout.
MELHOR_ENVIO_TOKEN=
STORE_POSTAL_CODE=
# Publicação e login administrativo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
IG_PUBLISH_ADMIN_IDS=
CRON_SECRET=
IG_PUBLISH_ENABLED=false
